    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>shiyinctl</AssemblyName>
    <RootNamespace>Shiyin.Ctl</RootNamespace>
  </PropertyGroup>
</Project>
