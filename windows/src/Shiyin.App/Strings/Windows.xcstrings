          }
        }
      }
    },
    "沒辦法註冊 Ctrl+Alt+Shift+R：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't register Ctrl+Alt+Shift+R: %@"
