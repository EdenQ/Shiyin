            "value": "Couldn't read the key from Credential Manager (error %lld)"
          }
        }
      }
    },
    "超過 15 秒沒有收到電腦的聲音：請確認線上會議有聲音在播": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No computer audio for over 15 seconds: check that the online meeting is playing sound"
