<Project Sdk="Microsoft.NET.Sdk">
  <!-- 拾音 Windows 版的 app（design-windows §11）：WinUI 3、不打包、畫面全部用 C# 建（不用 XAML 檔：XAML 編譯器只能在 Windows 上跑，
       這樣在 Mac 上也能編譯檢查）。只參考用到的 Windows App SDK 元件套件（D42：整包會帶進跟 sherpa-onnx 衝突的 onnxruntime.dll） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <RootNamespace>Shiyin.App</RootNamespace>
    <AssemblyName>Shiyin</AssemblyName>
    <Version>3.6.0</Version>
    <ApplicationIcon Condition="Exists('Assets/Shiyin.ico')">Assets/Shiyin.ico</ApplicationIcon>
    <!-- 正式建置（Windows 上）自帶 Windows App SDK。在 Mac 上只做編譯檢查：mt.exe、MakePri.exe 是 Windows 的程式跑不了，
         改成不自帶、不產生資源索引（.pri）。這樣建出來的東西不能拿去用 -->
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == '' and '$(OS)' == 'Windows_NT'">true</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">false</WindowsAppSDKSelfContained>
    <EnableCoreMrtTooling Condition="'$(OS)' != 'Windows_NT'">false</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled Condition="'$(OS)' != 'Windows_NT'">false</AppxGeneratePriEnabled>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shiyin.Platform.Windows/Shiyin.Platform.Windows.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Condition="'$(WindowsAppSDKSelfContained)' != 'true'" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets/Shiyin.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 翻譯表：Mac 的 Localizable.xcstrings（鍵是中文原文，D43、§11.4），加上 Windows 才有的字串（l10n.py windows-check、windows-apply） -->
    <EmbeddedResource Include="../../../Resources/Localizable.xcstrings" LogicalName="Localizable.xcstrings" />
    <EmbeddedResource Include="Strings/Windows.xcstrings" LogicalName="Windows.xcstrings" />
  </ItemGroup>
</Project>
