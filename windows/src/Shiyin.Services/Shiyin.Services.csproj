    <ProjectReference Include="../Shiyin.Data/Shiyin.Data.csproj" />
    <ProjectReference Include="../Shiyin.LLM/Shiyin.LLM.csproj" />
    <ProjectReference Include="../Shiyin.Engines/Shiyin.Engines.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shiyin.Tests" />
  </ItemGroup>
</Project>
